# Supabase PostgreSQL connection URL (use the session pooler URL with SSL).
DATABASE_URL=postgres://user:password@localhost:5434/rms

# Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated production frontend origins; local Vite origins are allowed in development.
FRONTEND_URL=http://localhost:5173,http://localhost:5174

PORT=3000
